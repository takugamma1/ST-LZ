
{% liquid
  # Reads two product metafields you create in Shopify admin:
  #   custom.paired_product  (product reference) -> the counterpart product
  #   custom.is_branded       (boolean)          -> true on the branded version
  assign paired = product.metafields.custom.paired_product.value
  assign is_branded = product.metafields.custom.is_branded.value

  assign branded_label = section.settings.branded_label
  assign plain_label = section.settings.plain_label
-%}

{%- if paired != blank -%}
  <div
    class="
      branded-toggle-section
      section
      section--{{ section.settings.section_width }}
      spacing-style
    "
    style="
      {% render 'spacing-style', settings: section.settings %}
      --bt-active-bg: {{ section.settings.active_bg }};
      --bt-active-fg: {{ section.settings.active_fg }};
      --bt-inactive-fg: {{ section.settings.inactive_fg }};
      --bt-track-bg: {{ section.settings.track_bg }};
      --bt-border: {{ section.settings.border_color }};
      --bt-radius: {{ section.settings.radius }}px;
      --bt-align: {{ section.settings.alignment }};
    "
  >
    <div class="branded-toggle">
      {%- if section.settings.heading != blank -%}
        <span class="branded-toggle__label">{{ section.settings.heading }}</span>
      {%- endif -%}

      <div class="branded-toggle__track" role="group" aria-label="{{ section.settings.heading | escape }}">
        {%- if is_branded -%}
          <span class="branded-toggle__option is-active" aria-current="true">{{ branded_label }}</span>
          <a href="{{ paired.url }}" class="branded-toggle__option">{{ plain_label }}</a>
        {%- else -%}
          <a href="{{ paired.url }}" class="branded-toggle__option">{{ branded_label }}</a>
          <span class="branded-toggle__option is-active" aria-current="true">{{ plain_label }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .branded-toggle {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: var(--bt-align, flex-start);
  }

  .branded-toggle__label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.8;
    color: var(--bt-inactive-fg, #0c1a3a);
  }

  .branded-toggle__track {
    display: inline-flex;
    padding: 4px;
    gap: 4px;
    background: var(--bt-track-bg, #f0f1f4);
    border: 1px solid var(--bt-border, transparent);
    border-radius: var(--bt-radius, 999px);
  }

  .branded-toggle__option {
    appearance: none;
    border: none;
    cursor: pointer;
    text-decoration: none;
    padding: 10px 22px;
    border-radius: calc(var(--bt-radius, 999px) - 4px);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--bt-inactive-fg, #0c1a3a);
    background: transparent;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
    white-space: nowrap;
  }

  .branded-toggle__option:hover:not(.is-active) {
    background: color-mix(in srgb, var(--bt-active-bg, #0c1a3a) 10%, transparent);
  }

  .branded-toggle__option.is-active {
    background: var(--bt-active-bg, #0c1a3a);
    color: var(--bt-active-fg, #ffffff);
    cursor: default;
  }

  .branded-toggle__option:active:not(.is-active) {
    transform: translateY(1px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Branded toggle",
  "tag": "section",
  "class": "branded-toggle-section-wrapper section-wrapper",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows a Branded / Non-branded switch on the product page. Requires two product metafields: custom.paired_product (product) and custom.is_branded (true/false). The switch only appears when paired_product is set."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Label above toggle",
      "default": "Kies je versie"
    },
    {
      "type": "text",
      "id": "branded_label",
      "label": "Branded option label",
      "default": "Met logo"
    },
    {
      "type": "text",
      "id": "plain_label",
      "label": "Non-branded option label",
      "default": "Zonder logo"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "color",
      "id": "active_bg",
      "label": "Active background",
      "default": "#0c1a3a"
    },
    {
      "type": "color",
      "id": "active_fg",
      "label": "Active text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "inactive_fg",
      "label": "Inactive text",
      "default": "#0c1a3a"
    },
    {
      "type": "color",
      "id": "track_bg",
      "label": "Track background",
      "default": "#f0f1f4"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Track border",
      "default": "#e6e8ed"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Branded toggle",
      "category": "Product"
    }
  ]
}
{% endschema %}
