{%- doc -%}
  Small hint banner shown above the product title that links/scrolls to the
  white-logo tool (#logo-whitener-tool). Renders ONLY on products that have
  the TeeInBlue customizer AND are not the explicitly non-branded duplicate.

  Copy + alignment are controlled globally in Theme settings > Logo tool hint.

  @param {object} product - the product to read the flags from (pass closest.product)
  @param {string} [anchor] - element id to scroll to (default #logo-whitener-tool)
{%- enddoc -%}

{%- liquid
  assign has_teeinblue = false
  if product.metafields.teeinblue.platform_product != blank
    assign has_teeinblue = true
  endif
  assign is_branded = product.metafields.custom.is_branded.value
  assign show_hint = false
  if has_teeinblue and is_branded != false
    assign show_hint = true
  endif

  assign anchor = anchor | default: '#logo-whitener-tool'
  assign hint_text = settings.logo_hint_text | default: 'Heb je een gekleurd logo? Maak het eerst wit met onze tool.'
  assign button_label = settings.logo_hint_button_label | default: 'Open de tool'
  assign icon = settings.logo_hint_icon
  assign align = settings.logo_hint_alignment | default: 'flex-end'
-%}

{%- if show_hint -%}
  <div class="logo-tool-hint-wrap{% if settings.logo_hint_full_width %} logo-tool-hint-wrap--full{% endif %}" style="--logo-hint-align: {{ align }};">
    <div class="logo-tool-hint">
      <span class="logo-tool-hint__text">
        {%- if icon != blank -%}<span class="logo-tool-hint__icon" aria-hidden="true">{{ icon }}</span>{%- endif -%}
        <span>{{ hint_text }}</span>
      </span>
      <a href="{{ anchor }}" class="logo-tool-hint__button" data-logo-tool-hint>
        {{ button_label }}
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="M19 12l-7 7-7-7"/></svg>
      </a>
    </div>
  </div>

  <style>
    .logo-tool-hint-wrap {
      display: flex;
      justify-content: var(--logo-hint-align, flex-end);
      margin-block: 4px 12px;
    }
    .logo-tool-hint {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px 16px;
      padding: 12px 16px;
      width: fit-content;
      max-width: 100%;
      background: var(--logo-tool-hint-bg, rgb(var(--color-foreground-rgb, 12 26 58) / 0.05));
      color: var(--color-foreground, #0c1a3a);
      border-radius: var(--logo-tool-hint-radius, 12px);
    }
    .logo-tool-hint-wrap--full .logo-tool-hint {
      width: 100%;
      justify-content: space-between;
    }
    .logo-tool-hint__text {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.9rem;
      line-height: 1.35;
    }
    .logo-tool-hint__icon { font-size: 1.15rem; line-height: 1; }
    .logo-tool-hint__button {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
      text-decoration: none;
      background: var(--color-foreground, #0c1a3a);
      color: var(--color-background, #ffffff);
      padding: 10px 18px;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      transition: filter 0.2s ease, transform 0.15s ease;
    }
    .logo-tool-hint__button:hover { filter: brightness(1.12); }
    .logo-tool-hint__button:active { transform: translateY(1px); }
    .logo-tool-hint__button svg { width: 15px; height: 15px; }
  </style>

  <script>
    if (!window.__logoToolHintBound) {
      window.__logoToolHintBound = true;
      document.addEventListener('click', function (e) {
        var link = e.target.closest('[data-logo-tool-hint]');
        if (!link) return;
        var id = (link.getAttribute('href') || '').replace('#', '');
        var target = id && document.getElementById(id);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', '#' + id);
        }
      });
    }
  </script>
{%- endif -%}
