{%- doc -%}
  Small hint banner inside the product details that links/scrolls to the
  white-logo tool (#logo-whitener-tool). Renders ONLY on branded products
  (custom.is_branded == true), so non-branded duplicates and regular
  products never show it.

  @param {object} product - the product to read the branded flag from (pass closest.product)
  @param {string} [hint_text] - the hint copy
  @param {string} [button_label] - the button label
  @param {string} [icon] - emoji/symbol shown before the text
  @param {string} [anchor] - the element id to scroll to (default #logo-whitener-tool)
{%- enddoc -%}

{%- liquid
  assign is_branded = product.metafields.custom.is_branded.value
  assign anchor = anchor | default: '#logo-whitener-tool'
  assign hint_text = hint_text | default: 'Heb je een gekleurd logo? Maak het eerst wit met onze tool.'
  assign button_label = button_label | default: 'Open de tool'
  assign icon = icon | default: '✨'
-%}

{%- if is_branded -%}
  <div class="logo-tool-hint">
    <span class="logo-tool-hint__text">
      {%- if icon != blank -%}<span class="logo-tool-hint__icon" aria-hidden="true">{{ icon }}</span>{%- endif -%}
      <span>{{ hint_text }}</span>
    </span>
    <a href="{{ anchor }}" class="logo-tool-hint__button" data-logo-tool-hint>
      {{ button_label }}
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="M19 12l-7 7-7-7"/></svg>
    </a>
  </div>

  <style>
    .logo-tool-hint {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px 16px;
      padding: 14px 16px;
      margin-block: 8px;
      background: var(--logo-tool-hint-bg, rgb(var(--color-foreground-rgb, 12 26 58) / 0.05));
      color: var(--color-foreground, #0c1a3a);
      border-radius: var(--logo-tool-hint-radius, 12px);
    }
    .logo-tool-hint__text {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.9rem;
      line-height: 1.35;
    }
    .logo-tool-hint__icon { font-size: 1.15rem; line-height: 1; }
    .logo-tool-hint__button {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
      text-decoration: none;
      background: var(--color-foreground, #0c1a3a);
      color: var(--color-background, #ffffff);
      padding: 10px 18px;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      transition: filter 0.2s ease, transform 0.15s ease;
    }
    .logo-tool-hint__button:hover { filter: brightness(1.12); }
    .logo-tool-hint__button:active { transform: translateY(1px); }
    .logo-tool-hint__button svg { width: 15px; height: 15px; }
  </style>

  <script>
    if (!window.__logoToolHintBound) {
      window.__logoToolHintBound = true;
      document.addEventListener('click', function (e) {
        var link = e.target.closest('[data-logo-tool-hint]');
        if (!link) return;
        var id = (link.getAttribute('href') || '').replace('#', '');
        var target = id && document.getElementById(id);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', '#' + id);
        }
      });
    }
  </script>
{%- endif -%}
